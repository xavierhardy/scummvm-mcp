# Per-machine game-data folders, shared by the MCP integration tests
# (test/mcp) and the MCP bench (scummvm_bench).
#
# Game data is not in the repository and sits somewhere different on every
# machine, so this is the ONLY place a game-data path may live: tracked code
# must never carry one. Copy this file next to it and edit:
#
#   cp game_paths.local.toml.example game_paths.local.toml
#
# `game_paths.local.toml` is gitignored. A per-game environment variable (listed
# below) overrides the entry here; a game configured by neither is **skipped**,
# in both test trees — never failed.
#
# `~` is expanded. Point at the folder that directly holds the game's data
# files — for the GOG/Mac bundles that is two levels below the .app, under
# Contents/Resources/game/game.
#
# `MCP_GAME_PATHS_FILE=/path/to/other.toml` reads a different file instead.

[games]
# --- SCUMM ---------------------------------------------------------------
monkey-ega-demo = "~/games/monkey1-dos-ega-demo-en"       # MONKEY_DEMO_PATH
monkey-ega-demo-de = "~/games/monkey1-dos-ega-demo-de"    # MONKEY_DEMO_DE_PATH
maniac-c64 = "~/games/maniac-c64-demo-en"                 # MANIAC_C64_PATH
maniac = "~/games/maniac-dos-en"                          # MANIAC_PATH (full game)
zak = "~/games/zak"                                       # ZAK_PATH
pass = "~/games/pass-dos-en"                              # PASS_DEMO_PATH
monkey2 = "~/games/monkeyisland2"                         # MONKEY2_PATH
atlantis = "~/games/atlantis-dos-demo1-en"                # ATLANTIS_DEMO_PATH
samnmax = "~/games/samnmax-dos-cd-demo-en"                # SAMNMAX_DEMO_PATH
tentacle = "~/games/dott"                                 # TENTACLE_PATH
ft-demo = "~/games/ft-dos-demo-en"                        # FT_DEMO_PATH
dig-demo = "~/games/dig-dos-demo-en"                      # DIG_DEMO_PATH
comi-demo = "~/games/comi-win-large-demo-en"              # COMI_DEMO_PATH

# --- Other engines -------------------------------------------------------
sword1-demo = "~/games/broken-sword-1-demo"               # SWORD1_DEMO_PATH
sword2-demo = "~/games/broken-sword-2-demo"               # SWORD2_DEMO_PATH
sky = "~/games/sky/Contents/Resources/game/game"          # SKY_PATH
queen = "~/games/queen/Contents/Resources/game/game"      # QUEEN_PATH
woodruff = "~/games/woodruff"                             # WOODRUFF_PATH
gob1-demo = "~/games/gob1-dos-demo1-en"                   # GOB1_DEMO_PATH
dw1-demo = "~/games/dw-dos-cd-demo-en/DISCWLD"            # DW1_DEMO_PATH
# Discworld II: only the *Windows* demo (dw2-win-demo-en) runs under ScummVM —
# the DOS demo is flagged unsupported by the engine and will not start.
dw2-demo = "~/games/dw2-win-demo-en"                      # DW2_DEMO_PATH
toon-demo = "~/games/toon-demo-en"                        # TOON_DEMO_PATH

# --- SCI (Sierra) --------------------------------------------------------
# Only the *interactive* demos are instrumented. Sierra shipped most of its
# Quest-series demos as non-interactive ones - a slideshow that runs itself
# and takes no input - and there is nothing for an agent to do in those.
gk1-demo = "~/games/gk1-dos-demo-en"                      # GK1_DEMO_PATH
sq6-demo = "~/games/sq6-dos-demo-en"                      # SQ6_DEMO_PATH

# --- More gob demos ------------------------------------------------------
gob2-demo = "~/games/gob2-dos-demo-en"                    # GOB2_DEMO_PATH
gob3-demo = "~/games/gob3-dos-demo-en"                    # GOB3_DEMO_PATH
# The v1.2 demo, not the other one: it is the one that stays up, and it opens
# on the copy-protection screen that type_text exists for.
ween-demo = "~/games/ween-dos-demo2-uk"                   # WEEN_DEMO_PATH

# --- AGS (Adventure Game Studio) -----------------------------------------
# Two shapes of the same engine: repixeled puts its verbs on a SCUMM-style
# bar of GUI buttons, the Sea Monster demo uses the engine's cursor modes.
zak-repixeled = "~/games/ags/zakrepixeled"                # ZAK_REPIXELED_PATH
zak-seamonster = "~/games/ags/zakseamonster-demo"         # ZAK_SEAMONSTER_PATH

# --- Mohawk --------------------------------------------------------------
# Only the CSTime game is instrumented; the mohawk engine also covers Myst
# and Riven, which are a different shape entirely.
cstime-demo = "~/games/cstime-win-demo-en"                # CSTIME_DEMO_PATH

# --- Full games -----------------------------------------------------------
# The retail games, beside the demos above. Each is a target of its own:
# a demo and its full game are different data and different saves.
ft-full = "~/games/full_throttle_scumm_win/Full Throttle/ft"
loom-full = "~/games/loom_scumm_win/Loom/loomcd"
indy3-full = "~/games/indycrusade_scumm_win/IndyCrusade/indy3"
atlantis-full = "~/games/indianajonesantlantis_scumm_win/IndianaJonesAntlantis/atlantis"
samnmax-full = "~/games/samandmax_scumm_win/SamAndMax/samnmax"
monkey-full = "~/games/monkeyisland_amiga_win/MonkeyIsland/fsuae/Hard Drives/data"
dw-full = "~/games/discworld_scumm_win/Discworld/dw-cd"
dw2-full = "~/games/discworld2_scumm_win/Discworld2/dw2"
sword1-full = "~/games/brokensword1_scumm_win/BrokenSword1/broken"
gob2-full = "~/games/goblins2_dos_win/Goblins2/g2"
gob3-full = "~/games/goblins3_dos_win/Goblins3/g3"
ween-full = "~/games/weentheprophecy_amiga_win/WeenTheProphecy/fsuae/Hard Drives/data"
gk1-full = "~/games/gabrielknight_dos_win/GabrielKnight/gabrielknight/GK1"
sq6-full = "~/games/spacequest6_dos_win/SpaceQuest6/SQ6"
kq5-full = "~/games/kingsquestv_dos_win/KingsQuestV/game"
kq6-full = "~/games/kingsquest6cd_scumm_win/KingsQuest6_cd/sci"
kq7-full = "~/games/kingsquest7_dos_win/KingsQuest7/kq7"
sq4-full = "~/games/spacequest4timerippers_dos_win/SpaceQuestIVRogerWilcoandtheTimeRippers/sq4"
sq5-full = "~/games/spacequest5_dos_win/SpaceQuest5/sq5"
pq3-full = "~/games/policequest3_dos_win/PoliceQuest3/disk/pq3"
kq1sci-full = "~/games/kingsquestenhanced_amiga_win/KingsQuestEnhanced/fsuae/Hard Drives/data"
kq4sci-full = "~/games/kingsquest4_dos_win/KingsQuest4/game"
sq1sci-full = "~/games/spacequestenhanced_dos_win/spacequestthesarienencounter/sq1"
qfg1-full = "~/games/questforglory_amiga_win/QuestForGlory/fsuae/Hard Drives/data"
qfg2-full = "~/games/questforglory2_amiga_win/QuestForGlory2/fsuae/Hard Drives/data"
sq2vga = "~/games/sq2vga_v2_win/SQ2VGA"
# Unpacked from the three AmigaDOS floppy images its repack ships.
pq2-full = "~/games/pq2-amiga/game"
